{
  "always_on_listening": {
    "synonyms": ["always-on", "always on listening", "hotword", "wake word", "continual microphone", "continuous mic"],
    "regex": ["\\b(always[- ]on|continuous|always listening) (microphone|mic|listening)\\b", "\\bwake word\\b"]
  },
  "webcam_access": {
    "synonyms": ["webcam", "camera feed", "video capture", "front camera", "rear camera"],
    "regex": ["\\b(webcam|camera) (access|stream|feed)\\b"]
  },
  "location_tracking": {
    "synonyms": ["gps tracking", "location tracking", "geo-tracking", "geolocation", "precise location"],
    "regex": ["\\b(location|gps|geolocation) (track|tracking|collection)\\b", "\\bprecise location\\b"]
  },
  "cookies": {
    "synonyms": ["third-party cookies", "cookie banner", "tracking cookies"],
    "regex": ["\\bcookies?\\b", "\\bthird[- ]party cookies?\\b"]
  },
  "third_party_sharing": {
